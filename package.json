{
    "name": "f2f3-scrapper",
    "version": "0.8.2",
    "files": [
        "dist"
    ],
    "description": "A scraper to gather data from https://www.fiaformula2.com and https://www.fiaformula3.com",
    "keywords": [
        "f2",
        "f3",
        "Formula2 data",
        "Formula3 data",
        "Formula2API",
        "Formula3API",
        "F3 scrapper",
        "F2 scrapper",
        "f2 api",
        "f3 api"
    ],
    "homepage": "https://github.com/Matt443/F2F3-Scrapper#readme",
    "bugs": {
        "url": "https://github.com/Matt443/F2F3-Scrapper/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Matt443/F2F3-Scrapper.git"
    },
    "license": "GPL-3.0-or-later",
    "author": "Matt443",
    "type": "module",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js",
    "scripts": {
        "tests": "jest --watchAll --coverage  --detectOpenHandles src/*",
        "test": "jest src/*",
        "start": "node dist/index.js",
        "dev": "nodemon",
        "build": "tsc --project tsconfig.build.json && tsc-alias",
        "prettier": "prettier . --write"
    },
    "dependencies": {
        "axios": "^1.10.0",
        "cheerio": "^1.1.0",
        "prettier": "^3.6.2"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.10",
        "babel-jest": "^30.0.4",
        "dotenv": "^17.0.1",
        "jest": "^30.0.4",
        "nodemon": "^3.1.10",
        "ts-jest": "^29.4.0",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.20.3",
        "typescript": "^5.8.3"
    }
}
